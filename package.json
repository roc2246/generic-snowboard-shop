{
  "name": "generic-snowboard-shop-theme",
  "private": true,
  "scripts": {
    "build": "npm run build:styles && npm run build:scripts",
    "build:styles": "node scripts/build-styles.mjs",
    "build:scripts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "watch": "concurrently -k \"npm:watch:styles\" \"npm:watch:scripts\"",
    "watch:styles": "node scripts/build-styles.mjs --watch",
    "watch:scripts": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build:styles:prod": "node scripts/build-styles.mjs --compressed",
    "check:styles": "node scripts/build-styles.mjs --check && node scripts/validate-styles.mjs",
    "check": "npm run check:styles && npm run check:types",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "check:types": "node scripts/validate-types.mjs && npm run typecheck && npm run typecheck:strict"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sass": "^1.89.0",
    "typescript": "^5.8.0"
  }
}
